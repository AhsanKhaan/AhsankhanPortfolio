{
  "meta": {
    "name": "Ahsan Khan — Personal Brand",
    "version": "1.0.0",
    "site": "https://ahsankhaan.vercel.app",
    "note": "Single source of truth. Consumed by the Next.js site (Tailwind + app/brand.css), scripts/build-brand.mjs (email HTML), app/brand/social (LinkedIn PNGs) and future Python automation. Edit here, then run `npm run brand`."
  },
  "primitive": {
    "color": {
      "black": "#000000",
      "white": "#FFFFFF",
      "slate-900": "#111827",
      "slate-800": "#1F2937",
      "neutral-200": "#E5E5E5",
      "neutral-400": "#A3A3A3",
      "neutral-500": "#737373",
      "neutral-700": "#404040",
      "blue-400": "#60A5FA",
      "emerald-400": "#34D399",
      "sky-500": "#0EA5E9",
      "indigo-500": "#6366F1",
      "red-500": "#EF4444",
      "paper": "#F8FAFC",
      "ink": "#0F172A"
    }
  },
  "semantic": {
    "color": {
      "bg": "{black}",
      "surface": "{slate-900}",
      "surface-raised": "{slate-800}",
      "text": "{neutral-200}",
      "muted": "{neutral-400}",
      "border": "rgba(255, 255, 255, 0.12)",
      "accent-start": "{blue-400}",
      "accent-end": "{emerald-400}",
      "secondary-start": "{sky-500}",
      "secondary-end": "{indigo-500}",
      "on-accent": "{black}",
      "focus-ring": "{blue-400}",
      "danger": "{red-500}"
    },
    "gradient": {
      "accent": "linear-gradient(90deg, {accent-start} 0%, {accent-end} 100%)",
      "accent-vertical": "linear-gradient(180deg, {accent-start} 0%, {accent-end} 100%)",
      "secondary": "linear-gradient(90deg, {secondary-start} 0%, {secondary-end} 100%)"
    }
  },
  "component": {
    "button-primary": { "bg": "{gradient.accent}", "text": "{on-accent}", "outline": "{white}" },
    "button-ghost": { "border": "{text}", "text": "{text}", "hover-bg": "rgba(229, 229, 229, 0.10)" },
    "card": { "bg": "{surface}", "border": "{border}" },
    "chip": { "bg": "rgba(96, 165, 250, 0.10)", "border": "rgba(96, 165, 250, 0.35)", "text": "{text}" },
    "email": {
      "bg": "{white}",
      "text": "{ink}",
      "muted": "#475569",
      "link": "#2563EB",
      "bar-start": "{blue-400}",
      "bar-end": "{emerald-400}",
      "divider": "#E2E8F0"
    },
    "social": {
      "canvas": "{black}",
      "panel": "{surface}",
      "text": "{white}",
      "muted": "{neutral-400}",
      "headline-start": "{accent-start}",
      "headline-end": "{accent-end}",
      "footer": "{surface}"
    }
  },
  "typography": {
    "family": {
      "display": "Kanit",
      "body": "Geist",
      "mono": "Geist Mono",
      "email": "Arial, Helvetica, sans-serif"
    },
    "weight": { "light": 300, "regular": 400, "medium": 500, "bold": 700, "black": 900 },
    "scale": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "base": "1rem",
      "lg": "1.125rem",
      "xl": "1.25rem",
      "2xl": "1.5rem",
      "display": "clamp(3rem, 12vw, 160px)",
      "hero": "clamp(3.5rem, 16vw, 17.5vw)"
    }
  },
  "radius": { "sm": "8px", "md": "16px", "lg": "24px", "xl": "40px", "pill": "9999px" },
  "spacing": { "xs": "4px", "sm": "8px", "md": "16px", "lg": "24px", "xl": "40px", "2xl": "64px" },
  "motion": {
    "ease": [0.25, 0.1, 0.25, 1],
    "duration-fast": "200ms",
    "duration-base": "700ms"
  },
  "social-canvas": { "width": 1080, "height": 1350, "safe-margin": 80 }
}
