# Contact form (app/api/contact/route.ts), CV requests (app/api/cv-request/route.ts)
# and the recruiter-email test script — all send via Gmail SMTP, authenticated as
# your real account (lib/mailer.ts), so "from" is genuinely your own address and can
# reach anyone, not just yourself.
#
# Setup (one time):
#   1. Enable 2-Step Verification on the Google account: https://myaccount.google.com/security
#   2. Create an App Password ("Mail", any device name) at https://myaccount.google.com/apppasswords
#   3. Set GMAIL_USER to the account's address, GMAIL_APP_PASSWORD to the 16-character
#      password that page gives you (not your normal Google password).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Required: secret used to sign time-limited CV download links (app/api/cv/download).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it secret — anyone with it could mint their own valid download links.
CV_ACCESS_SECRET=

# Optional: where contact-form messages are delivered. Defaults to brand/profile.json's
# email (ahsankhan.ubit@gmail.com) if unset — every submission lands in that inbox with
# the sender's name, email, inquiry type, company, budget and message.
CONTACT_TO_EMAIL=
