# Contact form (app/api/contact/route.ts) and CV requests (app/api/cv-request/route.ts)
# — required for both. Free key at https://resend.com (no domain verification needed
# to start: it can send from onboarding@resend.dev)
RESEND_API_KEY=

# Required: secret used to sign time-limited CV download links (app/api/cv/download).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it secret — anyone with it could mint their own valid download links.
CV_ACCESS_SECRET=

# Optional: where contact-form messages are delivered. Defaults to brand/profile.json's
# email (ahsankhan.ubit@gmail.com) if unset — every submission lands in that inbox with
# the sender's name, email, inquiry type, company, budget and message.
CONTACT_TO_EMAIL=

# Optional: verified sender, e.g. "Portfolio <hello@yourdomain.com>" (defaults to onboarding@resend.dev for testing)
CONTACT_FROM_EMAIL=
