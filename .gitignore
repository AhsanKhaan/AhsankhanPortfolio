# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local preview builds
/.next-preview/
!.env.example

# Claude Code skill tooling (installed locally via `npx skills add` / Skill tool) —
# not portfolio source, same reasoning as ignoring node_modules.
/.claude/skills/
/.agents/
skills-lock.json

# generated from brand/tokens.json + brand/profile.json + brand/templates/ by
# scripts/build-brand.mjs, which runs automatically before dev/build (predev/prebuild)
/brand/dist/
/app/brand.css
